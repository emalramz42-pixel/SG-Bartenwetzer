rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kader: Admin-Schreibschutz laeuft nur ueber den Passcode im Frontend,
    // nicht ueber diese Regeln (siehe README-Hinweis zur Sicherheit).
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /rounds/{roundId} {
      allow read: if true;
      allow write: if true;

      // Eine Stimme pro anonymer Geraete-Sitzung: die Dokument-ID muss
      // der eigenen Auth-UID entsprechen. Stimmen sind danach fuer
      // niemanden mehr aenderbar oder loeschbar.
      match /votes/{voteId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == voteId;
        allow update, delete: if false;
      }
    }
  }
}
